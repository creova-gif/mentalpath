# ============================================================
# MentalPath — Environment Configuration (.env.example)
# ============================================================

# ── 1. SUPABASE (Database, Auth & Canadian Edge Functions) ──
# Create a project at https://supabase.com with data residency in Canada (ca-central-1)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server / Edge Function service role key (NEVER expose to frontend; set in Supabase Secrets)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 2. STRIPE (Canadian Billing & Subscriptions) ────────────
# Publishable key from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Recurring Subscription Price IDs created in Stripe Dashboard (CAD currency)
# Solo: $49/mo CAD ($490/yr) · Group: $79/mo CAD ($790/yr)
VITE_STRIPE_PRICE_SOLO=price_1...
VITE_STRIPE_PRICE_SOLO_ANNUAL=price_1...
VITE_STRIPE_PRICE_GROUP=price_1...
VITE_STRIPE_PRICE_GROUP_ANNUAL=price_1...

# Optional Direct Stripe Hosted Payment Links (Instant checkout without backend)
VITE_STRIPE_PAYMENT_LINK_SOLO=https://buy.stripe.com/test_...
VITE_STRIPE_PAYMENT_LINK_GROUP=https://buy.stripe.com/test_...

# Secret Key & Webhook Secret (Set in Supabase Secrets for Edge Functions)
# STRIPE_SECRET_KEY=sk_test_51...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── 3. ANTHROPIC AI (Canadian PHIPA Note Assist) ────────────
# Used exclusively in Supabase Edge Function (ca-central-1 egress)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 4. SENTRY & MONITORING (Optional) ───────────────────────
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
