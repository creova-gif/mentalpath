# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry / Error Tracking (Optional)
VITE_SENTRY_DSN=

# Analytics (Optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Server-only Supabase Edge Function secret. 32-byte AES key, base64.
# Wraps per-practice session-note data keys. The browser never reads this.
# Not a KMS integration. Leave unset until the function environment is provisioned.
# NOTE_MASTER_KEY=
