# ── Frontend (Vite, build-time; all values are public) ─────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional telemetry — enable only after a data-processing agreement.
# Configured to exclude PHI (see src/app/lib/telemetry.ts).
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Local development only: skip the MFA screen (pair with private.app_settings)
VITE_MFA_OPTIONAL=false

# ── Edge Function secrets (set with `supabase secrets set`, never in the frontend) ──
# APP_URL=https://app.example.ca
# ALLOWED_ORIGINS=https://app.example.ca
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SOLO_PRICE_ID=
# STRIPE_AUTOMATIC_TAX=false
